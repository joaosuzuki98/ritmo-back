generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ExportFormat {
  CSV
  JSON
  PDF
}

enum HistoryEntity {
  HABIT
  EVENT
}

model User {
  id          String  @id
  name        String
  mascotName  String? @map("mascot_name")
  email       String
  totalPoints Float   @default(0) @map("total_points")
  level       Float   @default(1)
  createdAt   BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt   BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  categories              Category[]
  habits                  Habit[]
  events                  Event[]
  groupConsistencyGoals   GroupConsistencyGoal[]
  rewards                 Reward[]
  groupsCreated           Group[]                  @relation("GroupCreatedBy")
  groupMemberships        GroupMember[]
  dailyNotes              DailyNote[]
  scores                  Score[]
  exports                 Export[]
  backups                 Backup[]
  importedHealthData      ImportedHealthData[]
  routineTemplates        RoutineTemplate[]
  editHistory             EditHistory[]            @relation("UserEditHistory")
  todoTasks               TodoTask[]
  todoCategories          TodoCategory[]
  habitDisplayPreferences HabitDisplayPreference[]

  @@index([email])
  @@map("users")
}

model Category {
  id        String @id
  name      String
  userId    String @map("user_id")
  createdAt BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id])
  habits      Habit[]
  suggestions CategorySuggestion[]

  @@index([userId])
  @@map("categories")
}

model Habit {
  id                       String  @id
  userId                   String  @map("user_id")
  categoryId               String? @map("category_id")
  name                     String
  description              String?
  frequencyType            String  @map("frequency_type")
  weekDays                 String  @default("[]") @map("week_days")
  estimatedDurationMinutes Float?  @map("estimated_duration_minutes")
  preferredTime            BigInt? @map("preferred_time")
  priority                 String
  isFocusOfDay             Boolean @default(false) @map("is_focus_of_day")
  status                   String
  seasonalStart            BigInt? @map("seasonal_start")
  seasonalEnd              BigInt? @map("seasonal_end")
  createdAt                BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt                BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  user                    User                   @relation(fields: [userId], references: [id])
  category                Category?              @relation(fields: [categoryId], references: [id])
  completionRecords       CompletionRecord[]
  goals                   Goal[]
  reminders               Reminder[]
  streaks                 Streak[]
  dependencies            HabitDependency[]      @relation("HabitDependencyHabit")
  triggers                HabitDependency[]      @relation("HabitTrigger")
  conditions              HabitCondition[]       @relation("HabitConditionHabit")
  destinationConditions   HabitCondition[]       @relation("HabitConditionTarget")
  temporaryChallenges     TemporaryChallenge[]
  importedHealthData      ImportedHealthData[]
  eventSubtasks           EventSubtask[]
  categorySuggestions     CategorySuggestion[]
  habitCorrelationsOrigin HabitCorrelation[]     @relation("HabitCorrelationOrigin")
  habitCorrelationsTarget HabitCorrelation[]     @relation("HabitCorrelationTarget")
  habitImpact             HabitImpact?
  groupHabits             GroupHabit[]
  schedulingPreferences   SchedulingPreference[]

  @@index([userId, status])
  @@index([userId, preferredTime])
  @@index([categoryId])
  @@map("habits")
}

model HabitDependency {
  id             String @id
  habitId        String @map("habit_id")
  triggerHabitId String @map("trigger_habit_id")
  type           String
  createdAt      BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt      BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  habit        Habit @relation("HabitDependencyHabit", fields: [habitId], references: [id])
  triggerHabit Habit @relation("HabitTrigger", fields: [triggerHabitId], references: [id])

  @@index([habitId])
  @@index([triggerHabitId])
  @@map("habit_dependencies")
}

model HabitCondition {
  id               String  @id
  habitId          String  @map("habit_id")
  conditionHabitId String  @map("condition_habit_id")
  conditionRule    String  @map("condition_rule")
  conditionType    String? @map("condition_type")
  createdAt        BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt        BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  habit          Habit @relation("HabitConditionHabit", fields: [habitId], references: [id])
  conditionHabit Habit @relation("HabitConditionTarget", fields: [conditionHabitId], references: [id])

  @@index([habitId])
  @@index([conditionHabitId])
  @@map("habit_conditions")
}

model Event {
  id                        String  @id
  userId                    String  @map("user_id")
  title                     String
  dateTime                  BigInt  @map("date_time")
  endTime                   BigInt? @map("end_time")
  location                  String?
  description               String?
  recurrence                String
  notificationMinutesBefore Float?  @map("notification_minutes_before")
  countdownEnabled          Boolean @default(false) @map("countdown_enabled")
  conversionOrigin          String  @map("conversion_origin")
  reminderType              String? @map("reminder_type")
  createdAt                 BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt                 BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  user      User           @relation(fields: [userId], references: [id])
  subtasks  EventSubtask[]
  reminders Reminder[]

  @@index([userId])
  @@map("events")
}

model EventSubtask {
  id        String  @id
  eventId   String  @map("event_id")
  habitId   String  @map("habit_id")
  dueDate   BigInt? @map("due_date")
  createdAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  event Event @relation(fields: [eventId], references: [id])
  habit Habit @relation(fields: [habitId], references: [id])

  @@index([eventId])
  @@index([habitId])
  @@map("event_subtasks")
}

model IncompletionReason {
  id          String @id
  description String
  createdAt   BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt   BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  records CompletionRecord[]

  @@map("incompletion_reasons")
}

model CompletionRecord {
  id                     String  @id
  habitId                String  @map("habit_id")
  date                   BigInt
  status                 String
  completionTime         BigInt? @map("completion_time")
  incompletionReasonId   String? @map("incompletion_reason_id")
  note                   String?
  distractionLockEnabled Boolean @default(false) @map("distraction_lock_enabled")
  createdAt              BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt              BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  habit              Habit               @relation(fields: [habitId], references: [id])
  incompletionReason IncompletionReason? @relation(fields: [incompletionReasonId], references: [id])

  @@index([habitId])
  @@index([date])
  @@map("completion_records")
}

model Streak {
  id            String @id
  habitId       String @map("habit_id")
  currentStreak Float  @default(0) @map("current_streak")
  longestStreak Float  @default(0) @map("longest_streak")
  updatedAt     BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  habit Habit @relation(fields: [habitId], references: [id])

  @@index([habitId])
  @@map("streaks")
}

model DailyNote {
  id        String @id
  userId    String @map("user_id")
  date      BigInt
  text      String
  createdAt BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
  @@map("daily_notes")
}

model Goal {
  id           String @id
  habitId      String @map("habit_id")
  deadlineType String @map("deadline_type")
  description  String
  targetValue  Float  @map("target_value")
  currentValue Float  @default(0) @map("current_value")
  status       String
  createdAt    BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt    BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  habit   Habit    @relation(fields: [habitId], references: [id])
  rewards Reward[]

  @@index([habitId])
  @@map("goals")
}

model GroupConsistencyGoal {
  id               String  @id
  userId           String  @map("user_id")
  targetPercentage Float   @map("target_percentage")
  description      String?
  includedHabitIds String  @map("included_habit_ids")
  periodStart      BigInt  @map("period_start")
  periodEnd        BigInt  @map("period_end")
  createdAt        BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt        BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("group_consistency_goals")
}

model TemporaryChallenge {
  id           String @id
  habitId      String @map("habit_id")
  durationDays Float  @map("duration_days")
  startDate    BigInt @map("start_date")
  status       String
  createdAt    BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt    BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  habit Habit @relation(fields: [habitId], references: [id])

  @@index([habitId])
  @@map("temporary_challenges")
}

model Reward {
  id          String  @id
  userId      String  @map("user_id")
  goalId      String? @map("goal_id")
  description String
  redeemed    Boolean @default(false)
  redeemedAt  BigInt? @map("redeemed_at")
  createdAt   BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt   BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  user User  @relation(fields: [userId], references: [id])
  goal Goal? @relation(fields: [goalId], references: [id])

  @@index([userId])
  @@index([goalId])
  @@map("rewards")
}

model Reminder {
  id                   String  @id
  habitId              String? @map("habit_id")
  eventId              String? @map("event_id")
  type                 String
  calculatedTime       BigInt? @map("calculated_time")
  geofenceLat          Float?  @map("geofence_lat")
  geofenceLng          Float?  @map("geofence_lng")
  geofenceRadiusMeters Float?  @map("geofence_radius_m")
  sentAt               BigInt? @map("sent_at")
  createdAt            BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt            BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  habit Habit? @relation(fields: [habitId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])

  @@index([habitId])
  @@index([eventId])
  @@map("reminders")
}

model RoutineTemplate {
  id               String @id
  userId           String @map("user_id")
  name             String
  includedHabitIds String @map("included_habit_ids")
  includedEvents   String @map("included_events")
  createdAt        BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt        BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("routine_templates")
}

model HabitDisplayPreference {
  id              String @id
  userId          String @map("user_id")
  weekDay         Float  @map("week_day")
  orderedHabitIds String @map("ordered_habit_ids")
  createdAt       BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt       BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([weekDay])
  @@map("habit_display_preferences")
}

model TodoTask {
  id         String  @id
  userId     String  @map("user_id")
  title      String
  category   String
  isComplete Boolean @map("is_complete")
  createdAt  BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt  BigInt  @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([category])
  @@map("todo_tasks")
}

model TodoCategory {
  id        String @id
  userId    String @map("user_id")
  name      String
  createdAt BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("created_at")
  updatedAt BigInt @default(dbgenerated("((EXTRACT(epoch FROM CURRENT_TIMESTAMP) * (1000)::numeric))::bigint")) @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("todo_categories")
}

// ===== backend-only entities retained outside the sync contract =====
model Score {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("usuario_id")
  source    String   @map("origem")
  points    Int      @map("pontos")
  createdAt DateTime @default(now()) @map("criado_em")

  user User @relation(fields: [userId], references: [id])

  @@map("scores")
}

model Group {
  id        String @id @default(uuid()) @db.Uuid
  name      String @map("nome")
  createdBy String @map("criado_por")

  creator User          @relation("GroupCreatedBy", fields: [createdBy], references: [id])
  members GroupMember[]
  habits  GroupHabit[]

  @@map("groups")
}

model GroupMember {
  groupId  String   @map("grupo_id") @db.Uuid
  userId   String   @map("usuario_id")
  joinedAt DateTime @default(now()) @map("entrou_em")

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@id([groupId, userId])
  @@map("group_members")
}

model GroupHabit {
  id      String @id @default(uuid()) @db.Uuid
  groupId String @map("grupo_id") @db.Uuid
  habitId String @map("habito_id")
  name    String @map("nome")

  group Group @relation(fields: [groupId], references: [id])
  habit Habit @relation(fields: [habitId], references: [id])

  @@map("group_habits")
}

model SchedulingPreference {
  id            String    @id @default(uuid()) @db.Uuid
  habitId       String    @map("habito_id")
  suggestedTime DateTime? @map("horario_sugerido")
  reason        String?   @map("motivo")

  habit Habit @relation(fields: [habitId], references: [id])

  @@map("scheduling_preferences")
}

model CategorySuggestion {
  habitId             String @map("habito_id")
  suggestedCategoryId String @map("categoria_sugerida_id")
  confidence          Float  @map("confianca")

  habit             Habit    @relation(fields: [habitId], references: [id])
  suggestedCategory Category @relation(fields: [suggestedCategoryId], references: [id])

  @@id([habitId])
  @@map("category_suggestions")
}

model HabitCorrelation {
  id           String   @id @default(uuid()) @db.Uuid
  habitAId     String   @map("habito_a_id")
  habitBId     String   @map("habito_b_id")
  coefficient  Float    @map("coeficiente")
  calculatedAt DateTime @default(now()) @map("calculado_em")

  habitA Habit @relation("HabitCorrelationOrigin", fields: [habitAId], references: [id])
  habitB Habit @relation("HabitCorrelationTarget", fields: [habitBId], references: [id])

  @@map("habit_correlations")
}

model HabitImpact {
  habitId      String   @id @map("habito_id")
  impactIndex  Float    @map("indice_impacto")
  calculatedAt DateTime @default(now()) @map("calculado_em")

  habit Habit @relation(fields: [habitId], references: [id])

  @@map("habit_impacts")
}

model ProductivityScore {
  userId String   @map("usuario_id")
  date   DateTime @map("data") @db.Date
  score  Float    @map("score")

  @@id([userId, date])
  @@map("productivity_scores")
}

model EditHistory {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String?       @map("usuario_id")
  entityType    HistoryEntity @map("entidade_tipo")
  entityId      String        @map("entidade_id")
  changedField  String        @map("campo_alterado")
  previousValue String?       @map("valor_anterior")
  newValue      String?       @map("valor_novo")
  changedAt     DateTime      @default(now()) @map("alterado_em")

  user User? @relation("UserEditHistory", fields: [userId], references: [id])

  @@map("edit_history")
}

model ImportedHealthData {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("usuario_id")
  habitId  String?  @map("habito_id")
  date     DateTime @map("data") @db.Date
  steps    Int      @map("passos")
  calories Float    @map("calorias")

  user  User   @relation(fields: [userId], references: [id])
  habit Habit? @relation(fields: [habitId], references: [id])

  @@map("imported_health_data")
}

model Backup {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("usuario_id")
  filePath  String   @map("arquivo_path")
  createdAt DateTime @default(now()) @map("criado_em")

  user User @relation(fields: [userId], references: [id])

  @@map("backups")
}

model Export {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("usuario_id")
  format       ExportFormat @map("formato")
  includeNotes Boolean      @default(false) @map("incluir_anotacoes")
  generatedAt  DateTime     @default(now()) @map("gerado_em")

  user User @relation(fields: [userId], references: [id])

  @@map("exports")
}
