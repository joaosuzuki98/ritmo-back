# Server Configuration
SERVER_PORT=3000
SERVER_HOST=127.0.0.1
LOG_LEVEL=info
PROBLEM_DETAILS_BASE_URL=https://url.com
DATABASE_URL=postgresql://my_user:my_password@127.0.0.1:5433/my_database?schema=public
AUTH_ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_characters

# SMTP configuration used by password reset emails
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=no-reply@example.com

# PostgreSQL Configuration
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=my_user
POSTGRES_PASSWORD=my_password
POSTGRES_DB=my_database

# Github Configuration
GITHUB_TOKEN=your_token
